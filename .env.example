# Primary GitHub PAT (used as default across pools unless overridden in config.yml)
# Permissions: Actions (read/write), Administration (read/write)
GITHUB_PAT=github_pat_

# Optional when configuring from environment without config.yml.
# Use "personal" to discover all repositories owned by GITHUB_OWNER.
# GITHUB_SCOPE=personal
# Repository discovery cache TTL in seconds (0 disables caching).
# REPO_DISCOVERY_TTL=600
# Minimum seconds between GitHub scans for each pool.
# GITHUB_POLL_INTERVAL=60
# Stop before using the final PAT requests (shared across pools using that PAT).
# GITHUB_RATE_LIMIT_RESERVE=100
# Bounded concurrency for repository checks and runner operations.
# REPO_CHECK_WORKERS=6
# RUNNER_OPERATION_WORKERS=4

# Second account PAT (optional — only needed if you have pools for other orgs/accounts)
# CLIENT_GITHUB_PAT=ghp_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Global poll interval in seconds — applies to all pools
POLL_INTERVAL=15

# ── Dashboard (http://127.0.0.1:8080) ──────────────────────────────────────
# The orchestrator serves a web dashboard and control API. That port can start
# root containers on the host through the mounted Docker socket, so compose
# publishes it on 127.0.0.1 only. `make setup` generates the token below; set
# it yourself to keep a stable URL across rebuilds.
# RORCH_API_TOKEN=change-me
# Optional second token granting every read endpoint but no control action —
# hand this one out for dashboards, keep RORCH_API_TOKEN for operators.
# RORCH_API_READONLY_TOKEN=view-only
# RORCH_API_PORT=8080
# Days of dashboard history kept before pruning (0 disables pruning).
# HISTORY_RETENTION_DAYS=14
# Set to "off" to run without the state store — no dashboard, config.yml only.
# RORCH_DB=off

# ── Database ───────────────────────────────────────────────────────────────
# State (job history, config overrides, audit) lives in MariaDB. Required by
# docker-compose; without RORCH_DB_URL the orchestrator falls back to a local
# SQLite file, which is what the test suite uses.
MARIADB_PASSWORD=change-me
# MARIADB_USER=rorch
# MARIADB_DATABASE=rorch
# Override only to point at a database you manage yourself:
# RORCH_DB_URL=mysql://rorch:change-me@mariadb:3306/rorch

# ── Dashboard (Next.js gateway) ────────────────────────────────────────────
# The only service that faces the network. It holds the RORCH_API_* tokens
# server-side and never sends them to the browser.
# Sign session cookies. Generate with: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=change-me-at-least-16-chars
# Full control of runners and config:
DASHBOARD_ADMIN_PASSWORD=change-me
# Read-only: sees everything, changes nothing. Leave empty to disable.
# DASHBOARD_VIEWER_PASSWORD=
# Where the dashboard listens. 127.0.0.1 keeps it host-only; set 0.0.0.0 to
# reach it from the LAN — do that only behind TLS.
# DASHBOARD_BIND=127.0.0.1
# DASHBOARD_PORT=3000
# Session cookies require HTTPS unless this is 0. Set to 1 once TLS is in front.
# COOKIE_SECURE=0
# Set to 1 only when a proxy you control sets X-Forwarded-For, otherwise the
# login rate limiter can be bypassed with a spoofed header.
# TRUST_PROXY=0
# Network namespace for runner containers: "host" (default, historical) or
# "bridge" (isolates a job's service containers from host port collisions).
# RUNNER_NETWORK_MODE=host
